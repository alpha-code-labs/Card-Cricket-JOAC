title: PostGameplay
---
// Get the gameplay outcome variables from storage
<<declare $gameplayNumber = 0>>
<<declare $finalScore = 0>>
<<declare $targetScore = 0>>
<<declare $wicketsLost = 0>>
<<declare $gameResult = "">> // "won", "lost_wickets", "lost_runs"
<<declare $initialScore = 0 as Number>>


<<if IsButtonMode()>>
    <<LogGameplayEnd "ButtonModeGameplay{$gameplayNumber}">>
    <<EndButtonModeGameplay>>
<<else>>
// Check which gameplay based on gameplay number
<<if $gameplayNumber == 0>>
    <<jump scene_3>>
<<elseif $gameplayNumber == 1>>
    <<jump Gameplay1Result>>
<<elseif $gameplayNumber == 2>>
    <<jump Gameplay2Result>>
<<elseif $gameplayNumber == 3>>
    <<jump Gameplay3Result>>
<<elseif $gameplayNumber == 4>>
    <<jump Gameplay4Result>>
<<elseif $gameplayNumber == 5>>
    <<jump Gameplay5Result>>
<<elseif $gameplayNumber == 6>>
    <<jump Gameplay6Result>>
<<elseif $gameplayNumber == 7>>
    <<jump Gameplay7Result>>
<<elseif $gameplayNumber == 8>>
    <<jump Gameplay8Result>>
<<elseif $gameplayNumber == 9>>
    <<jump Gameplay9Result>>
<<elseif $gameplayNumber == 12>>
    <<jump Gameplay12Result>>
<<elseif $gameplayNumber == 13>>
    <<jump Gameplay13Result>>
<<elseif $gameplayNumber == 14>>
    <<jump Gameplay14Result>>
<<elseif $gameplayNumber == 15>>
    <<jump Gameplay15Result>>
<<elseif $gameplayNumber == 16>>
    <<jump Gameplay16Result>>
<<elseif $gameplayNumber == 17>>
    <<jump Gameplay17Result>>
<<else>>
    Error: Unknown gameplay number {$gameplayNumber}!
<<endif>>

<<endif>>
===


title: Gameplay0Result
---
// Gameplay 0: Tutorial batting first with 6 balls

<<LogGameplayEnd "Gameplay0">>
// <<EndEvent>>
<<jump scene_3>>
===
// =========================
// Updated as per new balls & runs mapping
// {gameplay}->{balls},{runs}
// 1->24,48 (batting first)
// 2->24,52 (batting first)
// 3->24,44 (Chase)
// 4->48,96 (batting first)
// 5->48,88 (batting first)
// 6->48,104 (Chase)
// 7->72,144  (batting first)
// 8->72,156 (batting first)
// 9->72,180 (Chase)
// 12->36,66 (Chase)
// 13->36,72 (Chase)
// 14->36,78 (Chase)
// 15->60,110 (Chase) 
// 16->60,120 (Chase)
// 17->60,130 (Chase)
// =========================

title: Gameplay1Result
---
<<LogGameplayEnd "Gameplay1">>
// Gameplay 1: Batting first with 24 balls -> performance tiers at 12 / 24 / 48 runs
<<if ($finalScore - $initialScore) < 12>>
    <<jump scene_7>>
<<elseif ($finalScore - $initialScore) < 24>>
    <<jump scene_8>>
<<elseif ($finalScore - $initialScore) < 48>>
    <<jump scene_9>>
<<else>>
    <<jump scene_10>>
<<endif>>
===

