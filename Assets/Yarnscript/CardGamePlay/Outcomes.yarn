title: PostGameplay
---
// Get the gameplay outcome variables from storage
<<declare $gameplayNumber = 0>>
<<declare $finalScore = 0>>
<<declare $targetScore = 0>>
<<declare $wicketsLost = 0>>
<<declare $gameResult = "">> // "won", "lost_wickets", "lost_runs"

// Check which gameplay based on gameplay number
<<if $gameplayNumber == 1>>
    <<jump Gameplay1Result>>
<<elseif $gameplayNumber == 2>>
    <<jump Gameplay2Result>>
<<elseif $gameplayNumber == 3>>
    <<jump Gameplay3Result>>
<<elseif $gameplayNumber == 4>>
    <<jump Gameplay4Result>>
<<elseif $gameplayNumber == 5>>
    <<jump Gameplay5Result>>
<<elseif $gameplayNumber == 6>>
    <<jump Gameplay6Result>>
<<elseif $gameplayNumber == 7>>
    <<jump Gameplay7Result>>
<<elseif $gameplayNumber == 8>>
    <<jump Gameplay8Result>>
<<elseif $gameplayNumber == 9>>
    <<jump Gameplay9Result>>
<<else>>
    Error: Unknown gameplay number {$gameplayNumber}!
<<endif>>
===

title: Gameplay1Result
---
// Gameplay 1: Batting first with 12 balls
<<if $wicketsLost >= 2>>
    <<jump scene_7>>
<<elseif $finalScore <= 11>>
    <<jump scene_8>>
<<elseif $finalScore <= 24>>
    <<jump scene_9>>
<<else>>
    <<jump scene_10>>
<<endif>>
===

title: Gameplay2Result
---
// Gameplay 2: Batting first with 24 balls
<<if $wicketsLost >= 2>>
    <<jump scene_12>>
<<elseif $finalScore <= 23>>
    <<jump scene_13>>
<<elseif $finalScore <= 47>>
    <<jump scene_14>>
<<else>>
    <<jump scene_15>>
<<endif>>
===

title: Gameplay3Result
---
// Gameplay 3: Chasing 15 runs in 12 balls
<<if $gameResult == "lost_wickets" || $finalScore < 15>>
    <<jump scene_17>>
<<else>>
    <<jump scene_18>>
<<endif>>
===

